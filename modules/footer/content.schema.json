{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "footer content",
  "type": "object",
  "required": ["name", "role"],
  "properties": {
    "name": { "type": "string" },
    "role": { "type": "string" },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image", "alt"],
        "properties": {
          "image": { "type": "string", "description": "module-relative path, resolved via ctx.asset()" },
          "alt": { "type": "string" },
          "href": { "type": "string" }
        }
      }
    }
  }
}
