{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["heading", "columns", "photos"],
  "properties": {
    "eyebrow": { "type": "string" }, "heading": { "type": "string" }, "note": { "type": "string" }, "countOverride": {},
    "columns": { "type": "integer", "minimum": 1, "maximum": 5 },
    "photos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["file", "label", "alt"],
        "properties": { "file": { "type": "string", "pattern": "^photos/[^/]+\\.(png|jpe?g)$" }, "label": { "type": "string" }, "alt": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
