{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["heading", "entries"],
  "properties": {
    "eyebrow": { "type": "string" }, "heading": { "type": "string" }, "note": { "type": "string" }, "countOverride": {},
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } }
  }, "additionalProperties": false,
  "definitions": {
    "link": { "type": "object", "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string" } }, "additionalProperties": false },
    "entry": {
      "type": "object", "required": ["period", "role", "company", "paragraphs"],
      "properties": { "period": { "type": "string" }, "role": { "type": "string" }, "company": { "type": "string" }, "location": { "type": "string" }, "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "links": { "type": "array", "items": { "$ref": "#/definitions/link" } } },
      "additionalProperties": false
    }
  }
}
