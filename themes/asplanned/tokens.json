{
  "colors": {
    "--ap-color-neutral-0": "#FFFFFF",
    "--ap-color-neutral-50": "#F5F5F5",
    "--ap-color-neutral-100": "#EBEBEB",
    "--ap-color-neutral-200": "#D8D8D8",
    "--ap-color-neutral-300": "#AEAEAE",
    "--ap-color-neutral-400": "#6B7280",
    "--ap-color-neutral-500": "#353535",
    "--ap-color-neutral-700": "#282828",
    "--ap-color-neutral-900": "#1A1A1A",

    "--ap-color-teal-900": "#003840",
    "--ap-color-teal-700": "#005F6A",
    "--ap-color-teal-500": "#2BA193",
    "--ap-color-teal-300": "#5BBFB3",
    "--ap-color-teal-100": "#D1EFEC",
    "--ap-color-teal-50": "#EBF8F6",

    "--ap-color-orange-900": "#7A2310",
    "--ap-color-orange-700": "#E45C3A",
    "--ap-color-orange-500": "#F4A261",
    "--ap-color-orange-300": "#F7C69A",
    "--ap-color-orange-100": "#FDEBD8",

    "--ap-color-gold-500": "#EAC871",
    "--ap-color-gold-200": "#F5E5B5",
    "--ap-color-gold-50": "#F7EAC9",

    "--ap-bg-page": "var(--ap-color-neutral-0)",
    "--ap-bg-secondary": "var(--ap-color-neutral-100)",
    "--ap-surface-muted": "var(--ap-color-neutral-100)",
    "--ap-surface-hover": "var(--ap-color-neutral-100)",
    "--ap-surface-active": "color-mix(in srgb, var(--ap-brand) 14%, var(--ap-bg-page))",

    "--ap-brand": "var(--ap-color-teal-700)",
    "--ap-brand-light": "var(--ap-color-teal-500)",
    "--ap-brand-opposite": "var(--ap-color-orange-700)",
    "--ap-brand-opposite-light": "var(--ap-color-orange-500)",
    "--ap-brand-fill": "var(--ap-color-gold-500)",

    "--ap-fg-heading": "var(--ap-color-neutral-500)",
    "--ap-fg-body": "var(--ap-color-neutral-900)",
    "--ap-fg-muted": "var(--ap-color-neutral-400)",
    "--ap-fg-note": "var(--ap-color-neutral-400)",
    "--ap-fg-accent": "var(--ap-color-orange-900)",
    "--ap-fg-inverted": "var(--ap-color-neutral-0)",

    "--ap-radius-sm": "0.5rem",
    "--ap-radius-md": "0.75rem",
    "--ap-radius-lg": "1rem",
    "--ap-radius-pill": "5rem",
    "--ap-btn-radius": "10px",

    "--ap-font-body": "'Lato', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "--ap-font-heading": "'Lato', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "--ap-font-mono": "ui-monospace, 'Courier New', monospace",

    "--ap-type-xs": "0.70rem",
    "--ap-type-sm": "0.8125rem",
    "--ap-type-body": "1rem",
    "--ap-type-h4": "1.10rem",
    "--ap-type-h3": "1.25rem",
    "--ap-type-h2": "1.5625rem",
    "--ap-type-h1": "1.9375rem",

    "--brand": "var(--ap-brand)",
    "--brand-light": "var(--ap-brand-light)",
    "--brand-opposite": "var(--ap-brand-opposite)",
    "--brand-opposite-light": "var(--ap-brand-opposite-light)",
    "--brand-fill": "var(--ap-brand-fill)",
    "--fg-body": "var(--ap-fg-body)",
    "--fg-muted": "var(--ap-fg-muted)",
    "--fg-note": "var(--ap-fg-note)",
    "--fg-accent": "var(--ap-fg-accent)",
    "--font-body": "var(--ap-font-body)",
    "--font-heading": "var(--ap-font-heading)",
    "--type-h1": "var(--ap-type-h1)",
    "--type-h2": "var(--ap-type-h2)",
    "--type-h3": "var(--ap-type-h3)",
    "--type-h4": "var(--ap-type-h4)",
    "--type-s": "var(--ap-type-sm)",
    "--type-xs": "var(--ap-type-xs)",
    "--btn-radius": "var(--ap-btn-radius)",
    "--bg-page": "var(--ap-bg-page)",
    "--surface-muted": "var(--ap-surface-muted)",
    "--surface-hover": "var(--ap-surface-hover)",
    "--surface-active": "var(--ap-surface-active)",

    "--border-hairline": "rgba(26, 26, 26, .15)",
    "--border-strong": "rgba(26, 26, 26, .25)",
    "--shadow-ambient": "rgba(26, 26, 26, .16)",
    "--fg-on-fill": "rgba(26, 26, 26, .75)",
    "--surface-hover-ghost": "rgba(26, 26, 26, .06)",
    "--scrollbar-track": "rgba(26, 26, 26, .06)",
    "--scrollbar-thumb": "rgba(26, 26, 26, .25)"
  },
  "fonts": {
    "provider": "self-hosted",
    "baseUrl": "./fonts",
    "families": {
      "body": {
        "family": "'Lato', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "files": [
          { "file": "lato-regular.woff2", "weight": 400, "style": "normal" },
          { "file": "lato-bold.woff2", "weight": 700, "style": "normal" },
          { "file": "lato-italic.woff2", "weight": 400, "style": "italic" }
        ]
      },
      "heading": {
        "family": "'Lato', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "files": []
      }
    }
  }
}
